# Deployer private key (no 0x prefix needed). Fund it with test X1T from the
# X1 EcoChain Discord faucet: /faucet <address> in #faucet (100 X1T / 24h).
PRIVATE_KEY=your_private_key_here

# Optional RPC override (defaults to the public Maculatus testnet endpoint)
X1_RPC_URL=https://maculatus-rpc.x1eco.com
